@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_Layout";
}

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="bi bi-hospital-fill text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h2 class="fw-bold text-dark mb-2">Hoş Geldiniz</h2>
                        <p class="text-muted">Hastane Otomasyon Sistemine giriş yapın</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <input type="hidden" asp-for="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
                        }
                        
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-semibold">
                                <i class="bi bi-person me-2"></i>Kullanıcı Adı
                            </label>
                            <input asp-for="Username" class="form-control form-control-lg" placeholder="Kullanıcı adınızı girin" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">
                                <i class="bi bi-lock me-2"></i>Şifre
                            </label>
                            <input asp-for="Password" class="form-control form-control-lg" placeholder="Şifrenizi girin" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Beni hatırla</label>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                            </button>
                        </div>

                        <div class="text-center">
                            <p class="mb-0 text-muted">Hesabınız yok mu? 
                                <a asp-action="Register" class="text-primary fw-semibold text-decoration-none">Kayıt Ol</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

