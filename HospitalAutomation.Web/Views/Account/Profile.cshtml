@model User
@{
    ViewData["Title"] = "Profilim";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                <h3 class="mb-0"><i class="bi bi-person-circle me-2"></i>Kullanıcı Profili</h3>
            </div>
            <div class="card-body p-4">
                <div class="row align-items-center mb-5">
                    <div class="col-md-4 text-center mb-3 mb-md-0">
                        <div class="position-relative d-inline-block">
                            @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                            {
                                <img src="@Model.ProfilePicturePath" class="rounded-circle shadow-sm object-fit-cover border border-4 border-white" style="width: 150px; height: 150px;" alt="Profil Resmi">
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center shadow-sm mx-auto border border-4 border-white" style="width: 150px; height: 150px;">
                                    <i class="bi bi-person-fill text-secondary" style="font-size: 5rem;"></i>
                                </div>
                            }
                            <button type="button" class="btn btn-primary position-absolute rounded-circle shadow-sm border border-2 border-white d-flex align-items-center justify-content-center p-0" style="width: 36px; height: 36px; bottom: 10px; right: 10px;" data-bs-toggle="modal" data-bs-target="#uploadModal">
                                <i class="bi bi-camera-fill" style="font-size: 1.1rem;"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-8">
                         <h4 class="fw-bold mb-1">@Model.FullName</h4>
                         <p class="text-muted mb-2">@Model.Role</p>
                         <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Aktif Kullanıcı</span>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold text-uppercase mb-1">Kullanıcı Adı</label>
                        <p class="fs-5 text-dark border-bottom pb-2">@Model.Username</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold text-uppercase mb-1">E-mail</label>
                        <p class="fs-5 text-dark border-bottom pb-2">@Model.Email</p>
                    </div>
                    
                    @if (Model.Role == UserRole.Doctor)
                    {
                        <div class="col-md-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Bölüm</label>
                            <p class="fs-5 text-dark border-bottom pb-2">@(Model.Department?.Name ?? "-")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Uzmanlık</label>
                            <p class="fs-5 text-dark border-bottom pb-2">@(Model.Specialization ?? "-")</p>
                        </div>
                    }
                </div>
                
                <div class="mt-5 d-flex gap-2">
                    <a asp-action="ChangePassword" class="btn btn-primary">
                        <i class="bi bi-key-fill me-2"></i>Şifre Değiştir
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Modals {
    <!-- Upload Modal -->
    <div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Profil Resmi Güncelle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-4">
                    <form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="profilePicture" class="form-label small text-muted">Resim Seçiniz (Max 5MB)</label>
                            <input type="file" class="form-control" id="profilePicture" name="profilePicture" accept="image/*" required>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Yükle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

