@model Patient
@{
    ViewData["Title"] = "Hasta Düzenle";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h3>Hasta Düzenle</h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NationalId" class="form-label"></label>
                            <input asp-for="NationalId" class="form-control" maxlength="11" />
                            <span asp-validation-for="NationalId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="BirthDate" class="form-label"></label>
                            <input asp-for="BirthDate" class="form-control" type="date" />
                            <span asp-validation-for="BirthDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select"></select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="BloodType" class="form-label"></label>
                            <select asp-for="BloodType" asp-items="Html.GetEnumSelectList<BloodType>()" class="form-select">
                                <option value="">Seçiniz</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CityId" class="form-label">Şehir</label>
                            <select asp-for="CityId" class="form-select" asp-items="ViewBag.Cities" id="CityId">
                                <option value="">Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="DistrictId" class="form-label">İlçe</label>
                            <select asp-for="DistrictId" class="form-select" asp-items="ViewBag.Districts" id="DistrictId">
                                <option value="">Seçiniz</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EmergencyContactName" class="form-label">Acil Durum İletişim Adı</label>
                            <input asp-for="EmergencyContactName" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="EmergencyContactPhone" class="form-label">Acil Durum İletişim Telefonu</label>
                            <input asp-for="EmergencyContactPhone" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MedicalHistory" class="form-label">Tıbbi Geçmiş</label>
                        <textarea asp-for="MedicalHistory" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Allergies" class="form-label">Alerjiler</label>
                        <textarea asp-for="Allergies" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Insurance" class="form-label">Sigorta</label>
                            <input asp-for="Insurance" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Occupation" class="form-label">Meslek</label>
                            <input asp-for="Occupation" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Medications" class="form-label">Kullandığı İlaçlar</label>
                        <textarea asp-for="Medications" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary">Güncelle</button>
                        <a asp-action="Index" class="btn btn-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Load districts for the current city if city is selected
            var currentCityId = $('#CityId').val();
            if (currentCityId) {
                loadDistricts(currentCityId, '@Model.DistrictId');
            }
            
            $('#CityId').change(function() {
                var cityId = $(this).val();
                loadDistricts(cityId, null);
            });
            
            function loadDistricts(cityId, selectedDistrictId) {
                var districtSelect = $('#DistrictId');
                
                districtSelect.empty();
                districtSelect.append('<option value="">Seçiniz</option>');
                
                if (cityId) {
                    $.ajax({
                        url: '@Url.Action("GetDistrictsByCity", "Patient")',
                        type: 'GET',
                        data: { cityId: cityId },
                        success: function(districts) {
                            $.each(districts, function(i, district) {
                                var option = $('<option></option>').val(district.id).text(district.name);
                                if (selectedDistrictId && district.id == selectedDistrictId) {
                                    option.attr('selected', 'selected');
                                }
                                districtSelect.append(option);
                            });
                        },
                        error: function() {
                            alert('İlçeler yüklenirken bir hata oluştu.');
                        }
                    });
                }
            }
        });
    </script>
}

