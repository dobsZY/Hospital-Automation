@model List<Patient>
@{
    ViewData["Title"] = "Hasta Listesi";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h2>Hasta Listesi</h2>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary">Yeni Hasta Ekle</a>
    </div>
</div>

<div class="row mb-3">
    <!-- Manual search hidden in favor of DataTables search -->
    <!--
    <div class="col-md-12">
        <form asp-action="Index" method="get" class="d-flex">
            <input type="text" name="searchTerm" class="form-control me-2" placeholder="Hasta ara (Ad, Soyad, TC Kimlik No, Telefon, Email)" value="@ViewBag.SearchTerm" />
            <button type="submit" class="btn btn-outline-primary">Ara</button>
        </form>
    </div>
    -->
</div>

<div class="table-responsive card shadow-sm p-3 border-0">
    <table class="table table-striped table-hover align-middle" id="patientsTable">
        <thead class="table-light">
            <tr>
                <th>TC Kimlik No</th>
                <th>Ad</th>
                <th>Soyad</th>
                <th>Doğum Tarihi</th>
                <th>Yaş</th>
                <th>Cinsiyet</th>
                <th>Telefon</th>
                <th>Email</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td>@patient.NationalId</td>
                    <td>@patient.FirstName</td>
                    <td>@patient.LastName</td>
                    <td>@patient.BirthDate.ToString("dd.MM.yyyy")</td>
                    <td>@patient.Age</td>
                    <td>@patient.Gender</td>
                    <td>@(patient.Phone ?? "-")</td>
                    <td>@(patient.Email ?? "-")</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-info text-white" title="Detay">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-sm btn-warning text-white" title="Düzenle">
                                <i class="bi bi-pencil"></i>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-action="Delete" asp-route-id="@patient.Id" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Sil" onclick="return confirmDelete(event, 'Bu hastayı silmek istediğinizden emin misiniz?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Hasta bulunamadı.
    </div>
}

