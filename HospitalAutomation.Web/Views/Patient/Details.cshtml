@model Patient
@{
    ViewData["Title"] = "Hasta Detayları";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h3>Hasta Detayları</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">TC Kimlik No:</dt>
                    <dd class="col-sm-9">@Model.NationalId</dd>

                    <dt class="col-sm-3">Ad Soyad:</dt>
                    <dd class="col-sm-9">@Model.FullName</dd>

                    <dt class="col-sm-3">Doğum Tarihi:</dt>
                    <dd class="col-sm-9">@Model.BirthDate.ToString("dd.MM.yyyy")</dd>

                    <dt class="col-sm-3">Yaş:</dt>
                    <dd class="col-sm-9">@Model.Age</dd>

                    <dt class="col-sm-3">Cinsiyet:</dt>
                    <dd class="col-sm-9">@Model.Gender</dd>

                    <dt class="col-sm-3">Telefon:</dt>
                    <dd class="col-sm-9">@(Model.Phone ?? "-")</dd>

                    <dt class="col-sm-3">E-mail:</dt>
                    <dd class="col-sm-9">@(Model.Email ?? "-")</dd>

                    <dt class="col-sm-3">Adres:</dt>
                    <dd class="col-sm-9">@(Model.Address ?? "-")</dd>

                    <dt class="col-sm-3">Kan Grubu:</dt>
                    <dd class="col-sm-9">@(Model.BloodType?.ToString() ?? "-")</dd>

                    <dt class="col-sm-3">Acil Durum İletişim:</dt>
                    <dd class="col-sm-9">@(Model.EmergencyContactName ?? "-") - @(Model.EmergencyContactPhone ?? "-")</dd>

                    <dt class="col-sm-3">Tıbbi Geçmiş:</dt>
                    <dd class="col-sm-9">@(Model.MedicalHistory ?? "-")</dd>

                    <dt class="col-sm-3">Alerjiler:</dt>
                    <dd class="col-sm-9">@(Model.Allergies ?? "-")</dd>
                </dl>

                <div class="mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
                    <a asp-action="Index" class="btn btn-secondary">Geri Dön</a>
                </div>
            </div>
        </div>
    </div>
</div>

