@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container-fluid p-0">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-dark mb-1">Hoş Geldiniz, @ViewBag.UserName</h2>
            <p class="text-muted mb-0">Hastane yönetim paneline genel bakış.</p>
        </div>
        <div class="col-auto">
            <span class="badge bg-white text-dark border px-3 py-2 shadow-sm">
                <i class="bi bi-calendar-event me-2 text-primary"></i>@DateTime.Now.ToString("dd MMMM yyyy, dddd")
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- İstatistik Kartı 1: Randevular -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm hover-scale">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <p class="text-muted fw-bold mb-1 text-uppercase small ls-1" style="letter-spacing: 1px;">Bugünkü Randevular</p>
                            <h2 class="display-5 fw-bold text-primary mb-0">@ViewBag.TodayAppointmentsCount</h2>
                        </div>
                        <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-calendar-check fs-3"></i>
                        </div>
                    </div>
                    <a asp-controller="Appointment" asp-action="Index" class="btn btn-link text-primary p-0 text-decoration-none fw-bold stretched-link">
                        Detayları Görüntüle <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- İstatistik Kartı 2: Hastalar -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm hover-scale">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <p class="text-muted fw-bold mb-1 text-uppercase small ls-1" style="letter-spacing: 1px;">Toplam Hasta</p>
                            <h2 class="display-5 fw-bold text-success mb-0">@ViewBag.TotalPatientsCount</h2>
                        </div>
                        <div class="icon-shape bg-success bg-opacity-10 text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-people fs-3"></i>
                        </div>
                    </div>
                    <a asp-controller="Patient" asp-action="Index" class="btn btn-link text-success p-0 text-decoration-none fw-bold stretched-link">
                        Listeye Git <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Hızlı İşlemler -->
        <div class="col-md-12 col-lg-4">
            <div class="card h-100 border-0 shadow-sm text-white hover-scale" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-hover) 100%);">
                <div class="card-body p-4 d-flex flex-column justify-content-center">
                    <h5 class="card-title fw-bold mb-4 text-white"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Hızlı İşlemler</h5>
                    <div class="d-grid gap-3">
                        <a asp-controller="Patient" asp-action="Create" class="btn btn-light fw-bold text-start border-0 shadow-sm text-dark">
                            <i class="bi bi-person-plus-fill me-2 text-primary"></i>Yeni Hasta Kaydı
                        </a>
                        <a asp-controller="Appointment" asp-action="Create" class="btn btn-outline-light fw-bold text-start border-2">
                            <i class="bi bi-calendar-plus-fill me-2"></i>Yeni Randevu Oluştur
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row mt-4 g-4">
        <!-- Chart 1: Weekly Activity -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 py-3">
                    <h5 class="card-title fw-bold text-primary mb-0"><i class="bi bi-graph-up me-2"></i>Son 7 Gün Randevu İstatistiği</h5>
                </div>
                <div class="card-body">
                    <canvas id="weeklyChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
        <!-- Chart 2: Department Distribution -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 py-3">
                    <h5 class="card-title fw-bold text-primary mb-0"><i class="bi bi-pie-chart me-2"></i>Bölüm Dağılımı</h5>
                </div>
                <div class="card-body">
                    <canvas id="deptChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Weekly Activity Chart
        const ctxWeekly = document.getElementById('weeklyChart').getContext('2d');
        new Chart(ctxWeekly, {
            type: 'line',
            data: {
                labels: @Json.Serialize(ViewBag.DailyLabels),
                datasets: [{
                    label: 'Randevu Sayısı',
                    data: @Json.Serialize(ViewBag.DailyData),
                    borderColor: '#4f46e5', // Primary color
                    backgroundColor: 'rgba(79, 70, 229, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#4f46e5',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Department Distribution Chart
        const ctxDept = document.getElementById('deptChart').getContext('2d');
        new Chart(ctxDept, {
            type: 'doughnut',
            data: {
                labels: @Json.Serialize(ViewBag.DeptLabels),
                datasets: [{
                    data: @Json.Serialize(ViewBag.DeptData),
                    backgroundColor: [
                        '#4f46e5', // Indigo
                        '#10b981', // Emerald
                        '#f59e0b', // Amber
                        '#ef4444', // Red
                        '#6366f1'  // Violet
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 20 }
                    }
                },
                cutout: '75%'
            }
        });
    </script>
}
