@model IEnumerable<HospitalAutomation.Models.Patient>

@{
    ViewData["Title"] = "Hasta Listesi";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-people me-2"></i>Hasta Listesi</h4>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 py-3 ps-4">TC Kimlik No</th>
                                <th class="border-0 py-3">Ad Soyad</th>
                                <th class="border-0 py-3">Oda No</th>
                                <th class="border-0 py-3">Kan Grubu</th>
                                <th class="border-0 py-3 text-end pe-4">Hızlı İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model)
                            {
                                <tr>
                                    <td class="ps-4">@patient.NationalId</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <span class="fw-medium">@patient.FullName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-door-open me-1"></i>-
                                        </span>
                                    </td>
                                    <td>
                                        @if (patient.BloodType.HasValue)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger">@patient.BloodType</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a asp-action="VitalSigns" asp-route-patientId="@patient.Id" class="btn btn-sm btn-outline-primary" title="Vital Bulgular">
                                                <i class="bi bi-activity"></i>
                                            </a>
                                            <a asp-action="MedicationTracking" asp-route-patientId="@patient.Id" class="btn btn-sm btn-outline-success" title="İlaç Takibi">
                                                <i class="bi bi-capsule"></i>
                                            </a>
                                            <a asp-action="NursingNotes" asp-route-patientId="@patient.Id" class="btn btn-sm btn-outline-info" title="Notlar">
                                                <i class="bi bi-journal-text"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted opacity-25 mb-3"></i>
                    <h4 class="text-muted">Kayıtlı hasta bulunmamaktadır.</h4>
                </div>
            }
        </div>
    </div>
</div>

