@model HospitalAutomation.Models.User

@{
    ViewData["Title"] = "Profilim";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-person-badge me-2"></i>Hemşire Profili</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4 align-items-center">
                        <div class="col-auto">
                            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center display-4" style="width: 80px; height: 80px;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        </div>
                        <div class="col">
                            <h3 class="fw-bold mb-0">@Model.FirstName @Model.LastName</h3>
                            <p class="text-muted mb-0">Hemşire</p>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Ad</label>
                            <p class="fw-bold fs-5 border-bottom pb-2">@Model.FirstName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Soyad</label>
                            <p class="fw-bold fs-5 border-bottom pb-2">@Model.LastName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">E-mail</label>
                            <p class="fw-bold fs-5 border-bottom pb-2">@Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Kullanıcı Adı</label>
                            <p class="fw-bold fs-5 border-bottom pb-2">@Model.Username</p>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-warning">
                            <i class="bi bi-key me-2"></i>Şifre Değiştir
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

