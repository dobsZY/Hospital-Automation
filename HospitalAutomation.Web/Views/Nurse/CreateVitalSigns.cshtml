@model HospitalAutomation.Models.VitalSigns
@using HospitalAutomation.Models

@{
    ViewData["Title"] = "Yeni Vital Bulgu";
    var patients = ViewBag.Patients as List<Patient>;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-heart-pulse me-2"></i>Yeni Vital Bulgu Kaydı</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateVitalSigns" method="post">
                        <input type="hidden" asp-for="NurseId" />
                        
                        <div class="mb-4">
                            <label asp-for="PatientId" class="form-label fw-bold">Hasta Seçimi</label>
                            <select asp-for="PatientId" class="form-select form-select-lg" required>
                                <option value="">-- Hasta Seçiniz --</option>
                                @if (patients != null)
                                {
                                    foreach (var p in patients)
                                    {
                                        <option value="@p.Id">@p.FullName (@p.NationalId)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PatientId" class="text-danger"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Temperature" class="form-label">Ateş (°C)</label>
                                <input asp-for="Temperature" class="form-control" type="number" step="0.1" required />
                                <span asp-validation-for="Temperature" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HeartRate" class="form-label">Nabız (/dk)</label>
                                <input asp-for="HeartRate" class="form-control" type="number" required />
                                <span asp-validation-for="HeartRate" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">Tansiyon (Sistolik / Büyük)</label>
                                <input asp-for="BloodPressureSystolic" class="form-control" type="number" placeholder="Örn: 120" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tansiyon (Diastolik / Küçük)</label>
                                <input asp-for="BloodPressureDiastolic" class="form-control" type="number" placeholder="Örn: 80" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RespiratoryRate" class="form-label">Solunum Hızı (/dk)</label>
                                <input asp-for="RespiratoryRate" class="form-control" type="number" required />
                                <span asp-validation-for="RespiratoryRate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OxygenSaturation" class="form-label">Oksijen Satürasyonu (%)</label>
                                <input asp-for="OxygenSaturation" class="form-control" type="number" />
                                <span asp-validation-for="OxygenSaturation" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Height" class="form-label">Boy (cm)</label>
                                <input asp-for="Height" class="form-control" type="number" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Weight" class="form-label">Kilo (kg)</label>
                                <input asp-for="Weight" class="form-control" type="number" step="0.1" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-bold">Notlar</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="VitalSigns" class="btn btn-light btn-lg px-4">İptal</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
