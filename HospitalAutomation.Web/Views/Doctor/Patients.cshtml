@model IEnumerable<HospitalAutomation.Models.Patient>

@{
    ViewData["Title"] = "Hastalarım";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-people me-2"></i>Hasta Listesi</h4>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 py-3 ps-4">TC Kimlik No</th>
                                <th class="border-0 py-3">Ad Soyad</th>
                                <th class="border-0 py-3">Doğum Tarihi</th>
                                <th class="border-0 py-3">Telefon</th>
                                <th class="border-0 py-3 text-end pe-4">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model)
                            {
                                <tr>
                                    <td class="ps-4">@patient.NationalId</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <span class="fw-medium">@patient.FullName</span>
                                        </div>
                                    </td>
                                    <td>@patient.BirthDate.ToString("dd.MM.yyyy") (@patient.Age)</td>
                                    <td>@patient.Phone</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a asp-action="MedicalRecords" asp-route-patientId="@patient.Id" class="btn btn-sm btn-outline-primary" title="Geçmiş Kayıtlar">
                                                <i class="bi bi-journal-medical"></i>
                                            </a>
                                            <a asp-action="CreateMedicalRecord" asp-route-patientId="@patient.Id" class="btn btn-sm btn-outline-success" title="Yeni Kayıt">
                                                <i class="bi bi-file-plus"></i>
                                            </a>
                                            <a asp-controller="Patient" asp-action="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-info" title="Detaylar">
                                                <i class="bi bi-info-circle"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted opacity-25 mb-3"></i>
                    <h4 class="text-muted">Henüz hasta kaydınız bulunmamaktadır.</h4>
                </div>
            }
        </div>
    </div>
</div>

