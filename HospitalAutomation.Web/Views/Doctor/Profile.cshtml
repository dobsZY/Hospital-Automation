@model HospitalAutomation.Models.User
@using HospitalAutomation.Models

@{
    ViewData["Title"] = "Profilim";
    var departments = ViewBag.Departments as List<Department>;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-person-badge me-2"></i>Doktor Profili</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Profile" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Username" />
                        <input type="hidden" asp-for="Role" />
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="IsActive" />
                        <input type="hidden" asp-for="PasswordHash" />

                        <div class="row mb-4 align-items-center">
                            <div class="col-auto">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center display-4" style="width: 80px; height: 80px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                            </div>
                            <div class="col">
                                <h3 class="fw-bold mb-0">Dr. @Model.FirstName @Model.LastName</h3>
                                <p class="text-muted mb-0">@Model.Specialization</p>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label">Ad</label>
                                <input asp-for="FirstName" class="form-control" required />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label">Soyad</label>
                                <input asp-for="LastName" class="form-control" required />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">E-mail</label>
                                <input asp-for="Email" class="form-control" required />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Kullanıcı Adı</label>
                                <input asp-for="Username" class="form-control" disabled />
                                <small class="text-muted">Kullanıcı adı değiştirilemez.</small>
                            </div>
                        </div>

                        <h5 class="text-secondary border-bottom pb-2 mb-3">Mesleki Bilgiler</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="DepartmentId" class="form-label">Bölüm</label>
                                <select asp-for="DepartmentId" class="form-select" disabled>
                                    <option value="">-- Seçiniz --</option>
                                    @if (departments != null)
                                    {
                                        foreach (var dept in departments)
                                        {
                                            <option value="@dept.Id">@dept.Name</option>
                                        }
                                    }
                                </select>
                                <input type="hidden" asp-for="DepartmentId" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MedicalLicenseNumber" class="form-label">Lisans No</label>
                                <input asp-for="MedicalLicenseNumber" class="form-control" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Specialization" class="form-label">Uzmanlık Alanı</label>
                                <input asp-for="Specialization" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExperienceYears" class="form-label">Deneyim (Yıl)</label>
                                <input asp-for="ExperienceYears" class="form-control" type="number" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Education" class="form-label">Eğitim Bilgileri</label>
                                <textarea asp-for="Education" class="form-control" rows="2"></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-warning">
                                <i class="bi bi-key me-2"></i>Şifre Değiştir
                            </a>
                            <button type="submit" class="btn btn-primary px-4">Güncelle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

