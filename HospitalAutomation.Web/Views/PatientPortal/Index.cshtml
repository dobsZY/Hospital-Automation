@model dynamic
@{
    ViewData["Title"] = "Hasta Portalı";
    var upcomingAppointments = ViewBag.UpcomingAppointments as List<HospitalAutomation.Models.Appointment>;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-primary text-white overflow-hidden position-relative welcome-card">
                <div class="card-body p-4 position-relative z-index-1">
                    <h2 class="fw-bold mb-2">Hoş Geldiniz, @ViewBag.PatientName</h2>
                    <p class="lead mb-0 opacity-75">Sağlık durumunuzu buradan takip edebilirsiniz.</p>
                </div>
                <div class="position-absolute top-0 end-0 p-3 opacity-25">
                    <i class="bi bi-heart-pulse display-1"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Quick Actions -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold text-primary">
                        <i class="bi bi-lightning-charge me-2"></i>Hızlı İşlemler
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-3">
                        <a asp-action="CreateAppointment" class="btn btn-primary btn-lg text-start">
                            <i class="bi bi-calendar-plus me-2"></i> Yeni Randevu Al
                        </a>
                        <a asp-action="Appointments" class="btn btn-outline-primary btn-lg text-start">
                            <i class="bi bi-calendar-check me-2"></i> Randevularım
                        </a>
                        <a asp-action="MedicalRecords" class="btn btn-outline-primary btn-lg text-start">
                            <i class="bi bi-file-medical me-2"></i> Tıbbi Kayıtlarım
                        </a>
                        <a asp-action="Profile" class="btn btn-outline-secondary btn-lg text-start">
                            <i class="bi bi-person-gear me-2"></i> Profil Bilgilerim
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Appointments -->
        <div class="col-lg-8">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-primary">
                        <i class="bi bi-calendar-event me-2"></i>Yaklaşan Randevular
                    </h5>
                    <a asp-action="Appointments" class="btn btn-sm btn-link text-decoration-none">Tümünü Gör</a>
                </div>
                <div class="card-body p-0">
                    @if (upcomingAppointments != null && upcomingAppointments.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var appt in upcomingAppointments)
                            {
                                <div class="list-group-item p-3 border-0 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle p-3 me-3 text-primary">
                                                <i class="bi bi-calendar-day fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-1 fw-bold">@appt.Doctor?.FullName</h6>
                                                <p class="mb-1 text-muted small">
                                                    <i class="bi bi-hospital me-1"></i>@(appt.Doctor?.Department?.Name ?? "Bölüm Belirtilmemiş")
                                                </p>
                                                <span class="badge bg-info bg-opacity-10 text-info">
                                                    <i class="bi bi-clock me-1"></i>@appt.AppointmentDate.ToString("dd.MM.yyyy") - @appt.AppointmentTime
                                                </span>
                                            </div>
                                        </div>
                                        <a asp-action="Appointments" class="btn btn-sm btn-outline-primary rounded-pill px-3">Detay</a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x display-4 mb-3 d-block opacity-25"></i>
                            <p>Yaklaşan randevunuz bulunmamaktadır.</p>
                            <a asp-action="CreateAppointment" class="btn btn-sm btn-primary mt-2">Hemen Randevu Al</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <!-- Health Summary (Placeholder) -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h5 class="fw-bold mb-1">Sağlıklı Yaşam Önerileri</h5>
                        <p class="text-muted mb-0">Düzenli kontrollerinizi yaptırmayı unutmayın.</p>
                    </div>
                    <i class="bi bi-heart-pulse text-danger display-4 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .welcome-card {
        background: linear-gradient(135deg, var(--bs-primary) 0%, #2a5298 100%);
    }
    .z-index-1 { z-index: 1; }
</style>

