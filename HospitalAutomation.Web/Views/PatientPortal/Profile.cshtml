@model HospitalAutomation.Models.Patient
@using HospitalAutomation.Models

@{
    ViewData["Title"] = "Profilim";
    var cities = ViewBag.Cities as List<City>;
    var districts = ViewBag.Districts as List<District>;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-person-circle me-2"></i>Profil Bilgilerim</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Profile" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="NationalId" />
                        <input type="hidden" asp-for="FirstName" />
                        <input type="hidden" asp-for="LastName" />
                        <input type="hidden" asp-for="Gender" />
                        <input type="hidden" asp-for="BirthDate" />

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label text-muted small">Ad Soyad</label>
                                <p class="fw-bold fs-5">@Model.FullName</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small">TC Kimlik No</label>
                                <p class="fw-bold fs-5">@Model.NationalId</p>
                            </div>
                        </div>

                        <h5 class="text-secondary border-bottom pb-2 mb-3">İletişim Bilgileri</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Telefon</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">E-mail</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label">Adres</label>
                                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CityId" class="form-label">İl</label>
                                <select asp-for="CityId" class="form-select" id="citySelect">
                                    <option value="">-- Seçiniz --</option>
                                    @if (cities != null)
                                    {
                                        foreach (var city in cities)
                                        {
                                            <option value="@city.Id">@city.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DistrictId" class="form-label">İlçe</label>
                                <select asp-for="DistrictId" class="form-select" id="districtSelect">
                                    <option value="">-- Önce İl Seçiniz --</option>
                                    @if (Model.CityId.HasValue && districts != null)
                                    {
                                        foreach (var district in districts.Where(d => d.CityId == Model.CityId))
                                        {
                                            <option value="@district.Id">@district.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <h5 class="text-secondary border-bottom pb-2 mb-3">Acil Durum Bilgileri</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="EmergencyContactName" class="form-label">Acil Durumda Aranacak Kişi</label>
                                <input asp-for="EmergencyContactName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmergencyContactPhone" class="form-label">Acil Durum Telefonu</label>
                                <input asp-for="EmergencyContactPhone" class="form-control" />
                            </div>
                        </div>

                        <h5 class="text-secondary border-bottom pb-2 mb-3">Diğer Bilgiler</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="BloodType" class="form-label">Kan Grubu</label>
                                <select asp-for="BloodType" class="form-select" asp-items="Html.GetEnumSelectList<HospitalAutomation.Models.Enums.BloodType>()">
                                    <option value="">-- Seçiniz --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Occupation" class="form-label">Meslek</label>
                                <input asp-for="Occupation" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Insurance" class="form-label">Sigorta</label>
                                <input asp-for="Insurance" class="form-control" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light">İptal</a>
                            <button type="submit" class="btn btn-primary px-4">Değişiklikleri Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#citySelect').change(function () {
                var cityId = $(this).val();
                var districtSelect = $('#districtSelect');
                districtSelect.empty().append('<option value="">-- Yükleniyor --</option>');

                if (cityId) {
                    $.get('/Patient/GetDistrictsByCity', { cityId: cityId }, function (data) {
                        districtSelect.empty().append('<option value="">-- Seçiniz --</option>');
                        $.each(data, function (index, item) {
                            districtSelect.append($('<option></option>').val(item.id).text(item.name));
                        });
                    });
                } else {
                    districtSelect.empty().append('<option value="">-- Önce İl Seçiniz --</option>');
                }
            });
        });
    </script>
}

