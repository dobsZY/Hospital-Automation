@model IEnumerable<HospitalAutomation.Models.Appointment>
@using HospitalAutomation.Models.Enums

@{
    ViewData["Title"] = "Randevularım";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">
            <i class="bi bi-calendar-check me-2"></i>Randevularım
        </h2>
        <a asp-action="CreateAppointment" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Yeni Randevu
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 py-3 ps-4">Tarih</th>
                                <th class="border-0 py-3">Doktor</th>
                                <th class="border-0 py-3">Bölüm</th>
                                <th class="border-0 py-3">Durum</th>
                                <th class="border-0 py-3 text-end pe-4">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold">@item.AppointmentDate.ToString("dd.MM.yyyy")</span>
                                            <span class="text-muted small">@item.AppointmentTime</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <span>@item.Doctor?.FullName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(item.Doctor?.Department?.Name ?? "Belirtilmemiş")
                                        </span>
                                    </td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case AppointmentStatus.Scheduled:
                                                <span class="badge bg-info">Planlandı</span>
                                                break;
                                            case AppointmentStatus.Completed:
                                                <span class="badge bg-success">Tamamlandı</span>
                                                break;
                                            case AppointmentStatus.Cancelled:
                                                <span class="badge bg-danger">İptal Edildi</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@item.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (item.Status == AppointmentStatus.Scheduled && item.AppointmentDate >= DateTime.Today)
                                        {
                                            <form asp-controller="Appointment" asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Randevuyu iptal etmek istediğinize emin misiniz?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-circle me-1"></i>İptal Et
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-calendar-x display-1 text-muted opacity-25"></i>
                    </div>
                    <h4 class="text-muted">Henüz randevunuz bulunmamaktadır.</h4>
                    <p class="text-muted mb-4">Sağlığınız için ilk adımınızı atın.</p>
                    <a asp-action="CreateAppointment" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-calendar-plus me-2"></i>Randevu Al
                    </a>
                </div>
            }
        </div>
    </div>
</div>

