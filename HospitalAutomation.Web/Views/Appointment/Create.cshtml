@model Appointment
@{
    ViewData["Title"] = "Yeni Randevu";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3>Yeni Randevu Oluştur</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DepartmentId" class="form-label">Bölüm</label>
                            <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments" id="DepartmentId">
                                <option value="">Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="DoctorId" class="form-label">Doktor</label>
                            <select asp-for="DoctorId" class="form-select" id="DoctorId" disabled>
                                <option value="">Önce Bölüm Seçiniz</option>
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PatientId" class="form-label">Hasta</label>
                            <select asp-for="PatientId" class="form-select" asp-items="ViewBag.Patients">
                                <option value="">Seçiniz</option>
                            </select>
                            <span asp-validation-for="PatientId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="AppointmentDate" class="form-label">Randevu Tarihi</label>
                            <input asp-for="AppointmentDate" class="form-control" type="date" id="AppointmentDate" disabled />
                            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AppointmentTime" class="form-label">Randevu Saati</label>
                            <select asp-for="AppointmentTime" class="form-select" id="AppointmentTime" disabled>
                                <option value="">Önce Tarih Seçiniz</option>
                            </select>
                            <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label">Durum</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AppointmentStatus>()">
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Symptoms" class="form-label">Şikayet / Belirtiler</label>
                        <textarea asp-for="Symptoms" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Notlar</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                        <a asp-action="Index" class="btn btn-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Bölüm değiştiğinde doktorları getir
            $('#DepartmentId').change(function() {
                var departmentId = $(this).val();
                var doctorSelect = $('#DoctorId');
                
                doctorSelect.empty();
                doctorSelect.append('<option value="">Seçiniz</option>');
                doctorSelect.prop('disabled', true);
                
                $('#AppointmentDate').prop('disabled', true).val('');
                $('#AppointmentTime').empty().append('<option value="">Önce Tarih Seçiniz</option>').prop('disabled', true);

                if (departmentId) {
                    $.ajax({
                        url: '@Url.Action("GetDoctorsByDepartment", "Appointment")',
                        type: 'GET',
                        data: { departmentId: departmentId },
                        success: function(doctors) {
                            if (doctors && doctors.length > 0) {
                                $.each(doctors, function(i, doctor) {
                                    doctorSelect.append($('<option></option>').val(doctor.id).text(doctor.fullName));
                                });
                                doctorSelect.prop('disabled', false);
                            } else {
                                doctorSelect.append('<option value="" disabled>Bu bölümde doktor bulunamadı</option>');
                            }
                        },
                        error: function() {
                            alert('Doktorlar yüklenirken bir hata oluştu.');
                        }
                    });
                }
            });

            // Doktor değiştiğinde tarih seçimini aç
            $('#DoctorId').change(function() {
                var doctorId = $(this).val();
                if (doctorId) {
                    $('#AppointmentDate').prop('disabled', false);
                } else {
                    $('#AppointmentDate').prop('disabled', true).val('');
                    $('#AppointmentTime').empty().append('<option value="">Önce Tarih Seçiniz</option>').prop('disabled', true);
                }
            });

            // Tarih değiştiğinde saatleri getir
            $('#AppointmentDate').change(function() {
                loadAvailableTimeSlots();
            });
            
            function loadAvailableTimeSlots() {
                var doctorId = $('#DoctorId').val();
                var date = $('#AppointmentDate').val();
                var timeSelect = $('#AppointmentTime');
                
                timeSelect.empty();
                timeSelect.append('<option value="">Seçiniz</option>');
                timeSelect.prop('disabled', true);
                
                if (doctorId && date) {
                    $.ajax({
                        url: '@Url.Action("GetAvailableTimeSlots", "Appointment")',
                        type: 'GET',
                        data: { 
                            doctorId: doctorId, 
                            date: date 
                        },
                        success: function(timeSlots) {
                            if (timeSlots && timeSlots.length > 0) {
                                $.each(timeSlots, function(i, timeSlot) {
                                    timeSelect.append($('<option></option>').val(timeSlot).text(timeSlot));
                                });
                                timeSelect.prop('disabled', false);
                            } else {
                                timeSelect.append($('<option></option>').text('Müsait saat bulunamadı').attr('disabled', true));
                            }
                        },
                        error: function() {
                            alert('Müsait saatler yüklenirken bir hata oluştu.');
                        }
                    });
                }
            }
        });
    </script>
}

